# HTTP
PORT=8000

# SQLite path (local default: ./data/trackforge.db)
# Railway with Volume mounted at /data:
# TRACKFORGE_DB=/data/trackforge.db
# TRACKFORGE_DB=

# Seed (runs only when explorer_records is empty)
TRACKFORGE_SEED=1
TRACKFORGE_SEED_HOURS=24
# Optional fixed seed start for stable timestamps across rebuilds:
# TRACKFORGE_SEED_BASE=2026-10-04T08:00:00Z

# Live simulator (30 TELEMETRY/min). Set 0 to freeze after seed.
# TRACKFORGE_LIVE_SIM=0
