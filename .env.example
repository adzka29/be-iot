# Nest / Trackforge — copy to .env for local overrides

PORT=8000

# SQLite path (local default: ./data/trackforge.db)
# Railway volume: TRACKFORGE_DB=/data/trackforge.db
# TRACKFORGE_DB=

# Seed + live simulator (production demo)
TRACKFORGE_SEED=1
TRACKFORGE_SEED_HOURS=24
# Leave unset so seed window ends at "now"
# TRACKFORGE_SEED_BASE=
TRACKFORGE_LIVE_SIM=1
# Optional: how many 30s ticks to backfill when DB is stale
# TRACKFORGE_LIVE_CATCHUP_TICKS=10
